# ==============================================================================
# SmallBook Application Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your real .env file to version control.

# ------------------------------------------------------------------------------
# 1. SUPABASE & DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Anon API Key (both names supported seamlessly)
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_KEY=your-supabase-anon-key

# Direct PostgreSQL connection string for Supabase database
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# Supabase Service Role Key (Required for background cleanups and storage tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. QDRANT VECTOR DATABASE (Required for RAG Ingestion & Hybrid Retrieval)
# ------------------------------------------------------------------------------
# URL of your Qdrant cluster (e.g. https://xyz-example.eu-central.aws.cloud.qdrant.io:6333 or http://localhost:6333)
QDRANT_URL=https://your-cluster.qdrant.io:6333

# Qdrant API Key (Required for Qdrant Cloud; leave empty for local unauthenticated Qdrant)
QDRANT_API_KEY=your-qdrant-api-key

# ------------------------------------------------------------------------------
# 3. HUGGING FACE / EMBEDDINGS (Optional / Recommended)
# ------------------------------------------------------------------------------
# Hugging Face User Access Token (used for downloading embedding & cross-encoder models)
HF_TOKEN=your-huggingface-token

# ------------------------------------------------------------------------------
# 4. DEVELOPER FREE-TIER LLM KEYS (Recommended for Free Tier & Study Tools)
# ------------------------------------------------------------------------------
# Google Gemini API key used for free-tier queries and 1M-token study tools
GEMINI_API_KEY=your-google-gemini-api-key
DEVELOPER_GEMINI_KEY=your-google-gemini-api-key

# Groq API key used for high-speed fallback generation (e.g. openai/gpt-oss-120b)
GROQ_API_KEY=your-groq-api-key
DEVELOPER_GROQ_KEY=your-groq-api-key

# ------------------------------------------------------------------------------
# 5. DATA ENCRYPTION AT REST (Required for BYOK Security)
# ------------------------------------------------------------------------------
# 32-byte URL-safe base64-encoded Fernet key used to encrypt user BYOK API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=your-fernet-base64-encryption-key

# ------------------------------------------------------------------------------
# 6. REDIS & CELERY (Required for Background Tasks, Locks, & Cooldowns)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery message broker and distributed concurrency mutexes
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. OPTIONAL LLM PROVIDER KEYS (For Local Dev / Fallback)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
