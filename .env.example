# ==============================================================================
# SmallBook Application Environment Configuration (.env.example)
# ==============================================================================
# Copy this template to .env in your project root:
#   cp .env.example .env
# Fill in your actual credentials below before launching the application.
# NEVER commit your real .env file or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE & DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Supabase project URL (Found in Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Secret / Service Role Key (Project Settings -> API -> service_role)
# Used for backend operations, background workers, and bypassing RLS for ingestion
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string (Found in Project Settings -> Database)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. QDRANT VECTOR DATABASE (Required for Document Ingestion & RAG)
# ------------------------------------------------------------------------------
# Qdrant cluster endpoint URL
# - Qdrant Cloud: https://[your-cluster-id].[region].cloud.qdrant.io:6333
# - Local Docker: http://localhost:6333
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333

# Qdrant API Key (Required for Qdrant Cloud; leave empty if using local unauthenticated Qdrant)
QDRANT_API_KEY=your-qdrant-api-key

# HTTP request timeout in seconds for upserting large vector batches (Default: 60.0)
QDRANT_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# 3. HUGGING FACE / EMBEDDINGS (Recommended)
# ------------------------------------------------------------------------------
# Hugging Face Access Token (https://huggingface.co/settings/tokens)
# Used to download sentence-transformers embedding & cross-encoder models
HF_TOKEN=your-huggingface-access-token

# ------------------------------------------------------------------------------
# 4. DEFAULT DEVELOPER LLM PROVIDER KEYS (Free-Tier & Study Tools)
# ------------------------------------------------------------------------------
# Google Gemini API key (https://aistudio.google.com/app/apikey)
# Powers default free-tier queries, large-context analysis, and study tools
GEMINI_API_KEY=your-google-gemini-api-key
DEVELOPER_GEMINI_KEY=your-google-gemini-api-key

# Groq Cloud API key (https://console.groq.com/keys)
# Powers ultra-fast interactive chat responses (e.g., LLaMA 3.3 70B)
GROQ_API_KEY=your-groq-api-key
DEVELOPER_GROQ_KEY=your-groq-api-key

# ------------------------------------------------------------------------------
# 5. DATA ENCRYPTION AT REST (Required for BYOK Security)
# ------------------------------------------------------------------------------
# 32-byte URL-safe base64-encoded Fernet key used to encrypt user BYOK API keys
# Generate a new secure key in terminal using:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# ------------------------------------------------------------------------------
# 6. REDIS & CELERY (Required for Background Ingestion & Distributed Mutex)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery broker, background tasks, and study tool rate locks
# - Local Development: redis://localhost:6379/0
# - Docker Compose: redis://redis:6379/0 (handled automatically inside docker-compose)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. NGROK SECURE TUNNEL (Optional for Public Testing / HTTPS Redirects)
# ------------------------------------------------------------------------------
# Obtain free static domain & token from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-static-subdomain.ngrok-free.app

# ------------------------------------------------------------------------------
# 8. TEST & OPTIONAL PROVIDER KEYS (Optional)
# ------------------------------------------------------------------------------
# Optional OpenAI / Anthropic developer keys if offering hosted fallback tiers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Temporary test key used during automated test suites
TEMP_API_FOR_TEST=your-test-groq-or-openai-key
